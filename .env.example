# CosmosMerkleClaim deployment (merkle-cosmos-evm)
VITE_CLAIM_CONTRACT=0x5FbDB2315678afecb367f032d93F642f64180aa3
# claims.json produced by `pnpm --filter merkle start` (served from public/ by default)
VITE_CLAIMS_URL=/claims.json
# 1 = Ethereum mainnet, 11155111 = Sepolia, 31337 = anvil
VITE_EVM_CHAIN_ID=1
# Optional; defaults to the chain's public RPC
VITE_EVM_RPC_URL=
# Cosmos chains the user can sign with (same coin type as the snapshot)
VITE_COSMOS_CHAIN_IDS=cosmoshub-4,osmosis-1,juno-1
VITE_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id
